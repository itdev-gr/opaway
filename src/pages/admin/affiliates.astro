---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout pageTitle="Affiliates" pageDescription="Create affiliate profiles, share their referral link, and track the bookings and commission each one brings in." activeSection="affiliates" docTitle="Affiliates — Admin">
	<div class="max-w-6xl">
		<!-- ── Create form ── -->
		<form id="aff-form" class="bg-white rounded-2xl border border-neutral-200 shadow-sm p-6 mb-8">
			<h2 class="text-base font-bold text-neutral-900 mb-4">New affiliate</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
				<div>
					<label for="aff-name" class="block text-sm font-medium text-neutral-700 mb-1">Name</label>
					<input id="aff-name" type="text" required placeholder="e.g. Maria K."
						class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
				</div>
				<div>
					<label for="aff-code" class="block text-sm font-medium text-neutral-700 mb-1">Referral code</label>
					<input id="aff-code" type="text" required placeholder="e.g. maria" pattern="[a-zA-Z0-9_-]{3,32}"
						class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
					<p class="text-xs text-neutral-400 mt-1">3-32 letters, numbers, - or _. Becomes the link: <span class="font-mono">/?ref=&lt;code&gt;</span>. Unique, case-insensitive.</p>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
				<div>
					<label for="aff-email" class="block text-sm font-medium text-neutral-700 mb-1">Email</label>
					<input id="aff-email" type="email" required placeholder="name@example.com"
						class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
					<p class="text-xs text-neutral-400 mt-1">Used to sign in to their affiliate portal.</p>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label for="aff-ctype" class="block text-sm font-medium text-neutral-700 mb-1">Commission</label>
						<select id="aff-ctype"
							class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]">
							<option value="percent">Percent (%)</option>
							<option value="fixed">Fixed (&euro;) per booking</option>
						</select>
					</div>
					<div>
						<label for="aff-cvalue" class="block text-sm font-medium text-neutral-700 mb-1">Value</label>
						<input id="aff-cvalue" type="number" min="0" step="0.01" required placeholder="10"
							class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
				<div>
					<label for="aff-password" class="block text-sm font-medium text-neutral-700 mb-1">Password</label>
					<div class="relative">
						<input id="aff-password" type="password" required minlength="8" placeholder="At least 8 characters" autocomplete="new-password"
							class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 pr-12 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
						<button type="button" data-toggle-pw="aff-password"
							class="absolute inset-y-0 right-0 px-3 text-xs font-semibold text-neutral-500 hover:text-neutral-700">Show</button>
					</div>
					<p class="text-xs text-neutral-400 mt-1">Creates their login. Share it with them directly — it is never emailed.</p>
				</div>
			</div>

			<div class="flex items-center gap-4">
				<button type="submit"
					class="px-6 py-2.5 bg-[#0C6B95] hover:bg-[#0a5c82] text-white text-sm font-semibold rounded-xl transition-colors disabled:opacity-50">
					Create affiliate
				</button>
				<p id="aff-status" class="text-sm"></p>
			</div>
		</form>

		<!-- ── List + report ── -->
		<div class="bg-white rounded-2xl border border-neutral-200 shadow-sm overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-neutral-50 text-left text-neutral-500">
							<th class="px-5 py-3 font-medium">Name</th>
							<th class="px-5 py-3 font-medium">Link</th>
							<th class="px-5 py-3 font-medium">Rate</th>
							<th class="px-5 py-3 font-medium">Bookings</th>
							<th class="px-5 py-3 font-medium">Revenue</th>
							<th class="px-5 py-3 font-medium">Commission</th>
							<th class="px-5 py-3 font-medium">Status</th>
							<th class="px-5 py-3 font-medium">Login</th>
							<th class="px-5 py-3 font-medium text-right">Actions</th>
						</tr>
					</thead>
					<tbody id="aff-rows">
						<tr><td colspan="9" class="px-5 py-8 text-center text-neutral-400">Loading…</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- ── Create login modal ── -->
	<div id="aff-login-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
		<div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm">
			<h3 class="text-base font-bold text-neutral-900 mb-1">Create login</h3>
			<p class="text-sm text-neutral-500 mb-4">Give <strong id="aff-login-name"></strong> access to the affiliate portal.</p>
			<label for="aff-login-email" class="block text-sm font-medium text-neutral-700 mb-1">Email</label>
			<input id="aff-login-email" type="email" required placeholder="name@example.com"
				class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 text-sm mb-3 focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
			<label for="aff-login-password" class="block text-sm font-medium text-neutral-700 mb-1">Password</label>
			<div class="relative mb-2">
				<input id="aff-login-password" type="password" required minlength="8" placeholder="At least 8 characters" autocomplete="new-password"
					class="w-full rounded-xl border border-neutral-200 px-4 py-2.5 pr-12 text-sm focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/30 focus:border-[#0C6B95]" />
				<button type="button" data-toggle-pw="aff-login-password"
					class="absolute inset-y-0 right-0 px-3 text-xs font-semibold text-neutral-500 hover:text-neutral-700">Show</button>
			</div>
			<p id="aff-login-status" class="text-xs mb-4"></p>
			<div class="flex justify-end gap-3">
				<button id="aff-login-cancel" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl border border-neutral-200 text-neutral-600 hover:bg-neutral-50">Cancel</button>
				<button id="aff-login-confirm" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl bg-[#0C6B95] hover:bg-[#0a5c82] text-white disabled:opacity-60">Create login</button>
			</div>
		</div>
	</div>

	<!-- ── Delete confirm modal ── -->
	<div id="aff-delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
		<div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm">
			<h3 class="text-base font-bold text-neutral-900 mb-2">Delete affiliate?</h3>
			<p class="text-sm text-neutral-500 mb-5">This permanently deletes <strong id="aff-delete-name"></strong> and their referral link. Past bookings keep the recorded code and commission.</p>
			<div class="flex justify-end gap-3">
				<button id="aff-delete-cancel" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl border border-neutral-200 text-neutral-600 hover:bg-neutral-50">Cancel</button>
				<button id="aff-delete-confirm" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl bg-red-600 hover:bg-red-700 text-white">Delete</button>
			</div>
		</div>
	</div>
</AdminLayout>

<script>
	import { supabase } from '../../lib/supabase';
	import {
		groupByAffiliate, affiliateTotals, refUrl as buildRefUrl, rateLabel as buildRateLabel,
		TRANSFER_COLUMNS_ADMIN, TOUR_COLUMNS_ADMIN, type AffiliateBooking,
	} from '../../lib/affiliate-earnings';
	import { formatIban } from '../../lib/iban';

	type Affiliate = {
		id: string;
		name: string;
		email: string;
		phone: string;
		ref_code: string;
		commission_type: 'percent' | 'fixed';
		commission_value: number;
		active: boolean;
		created_at: string;
		user_id: string | null;
		iban: string;
		bank_holder: string;
	};

	// DB columns keep the legacy influencer_* names; the UI term is "affiliate".
	// The booking shape and the totals math live in src/lib/affiliate-earnings.ts,
	// shared with the affiliate's own portal so the numbers cannot drift apart.
	type AttributedBooking = AffiliateBooking;

	const rowsEl = document.getElementById('aff-rows')!;
	const statusEl = document.getElementById('aff-status');
	let affiliates: Affiliate[] = [];
	let bookingsByAff: Record<string, AttributedBooking[]> = {};
	let pendingDeleteId: string | null = null;
	const expanded = new Set<string>();

	function setStatus(msg: string, cls: string) {
		if (!statusEl) return;
		statusEl.textContent = msg;
		statusEl.className = `text-sm ${cls}`;
	}

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) => (
			{ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
		));
	}

	const eur = (n: number) => `€${(Number(n) || 0).toFixed(2)}`;

	const rateLabel = (i: Affiliate) => buildRateLabel(i.commission_type, i.commission_value);
	const refUrl    = (i: Affiliate) => buildRefUrl(window.location.origin, i.ref_code);

	async function loadData() {
		const [affRes, trRes, toRes] = await Promise.all([
			supabase.from('influencers').select('*').order('created_at', { ascending: false }),
			supabase.from('transfers').select(TRANSFER_COLUMNS_ADMIN).not('influencer_id', 'is', null),
			supabase.from('tours').select(TOUR_COLUMNS_ADMIN).not('influencer_id', 'is', null),
		]);

		if (affRes.error) {
			rowsEl.innerHTML = `<tr><td colspan="9" class="px-5 py-8 text-center text-red-500">Error loading affiliates: [${affRes.error.code}] ${escapeHtml(affRes.error.message)}</td></tr>`;
			return;
		}
		affiliates = (affRes.data ?? []) as Affiliate[];

		// Shared with the affiliate portal so both show identical numbers.
		bookingsByAff = groupByAffiliate((trRes.data ?? []) as any[], (toRes.data ?? []) as any[]);

		render();
	}

	const totalsFor = (i: Affiliate) => affiliateTotals(bookingsByAff[i.id] ?? []);

	/** Where to send this affiliate's commission. The affiliate maintains it themselves. */
	function payoutHtml(i: Affiliate): string {
		if (!i.iban) {
			return `<div class="px-5 py-3 border-b border-neutral-200 text-xs text-neutral-400">
				No payout details yet — the affiliate adds their IBAN from their own portal.
			</div>`;
		}
		return `<div class="px-5 py-3 border-b border-neutral-200 flex flex-wrap items-center gap-x-4 gap-y-1">
			<span class="text-[11px] uppercase tracking-wider text-neutral-500">Payout</span>
			<span class="font-mono text-xs text-neutral-800">${escapeHtml(formatIban(i.iban))}</span>
			${i.bank_holder ? `<span class="text-xs text-neutral-500">${escapeHtml(i.bank_holder)}</span>` : ''}
			<button data-iban="${escapeHtml(i.iban)}" class="px-2 py-1 text-xs font-semibold rounded-lg border border-neutral-200 text-neutral-600 hover:bg-sky-50">Copy IBAN</button>
		</div>`;
	}

	function bookingsDetailHtml(i: Affiliate): string {
		const all = bookingsByAff[i.id] ?? [];
		if (!all.length) return `${payoutHtml(i)}<p class="px-5 py-4 text-sm text-neutral-400">No bookings from this affiliate yet.</p>`;
		return `${payoutHtml(i)}
			<table class="w-full text-xs">
				<thead>
					<tr class="text-left text-neutral-400">
						<th class="px-5 py-2 font-medium">Date</th>
						<th class="px-5 py-2 font-medium">Booking</th>
						<th class="px-5 py-2 font-medium">Customer</th>
						<th class="px-5 py-2 font-medium">Total</th>
						<th class="px-5 py-2 font-medium">Commission</th>
						<th class="px-5 py-2 font-medium">Ride</th>
						<th class="px-5 py-2 font-medium">Payment</th>
					</tr>
				</thead>
				<tbody>
					${all.map((b) => `
						<tr class="border-t border-neutral-100 ${b.ride_status === 'cancelled' ? 'text-neutral-400 line-through' : 'text-neutral-700'}">
							<td class="px-5 py-2 whitespace-nowrap">${escapeHtml(b.date)} ${escapeHtml(b.time ?? '')}</td>
							<td class="px-5 py-2">${escapeHtml(b.label)}</td>
							<td class="px-5 py-2">${escapeHtml(b.customer)}</td>
							<td class="px-5 py-2">${eur(b.total_price)}</td>
							<td class="px-5 py-2 font-semibold">${eur(b.influencer_commission)}</td>
							<td class="px-5 py-2">${escapeHtml(b.ride_status ?? '')}</td>
							<td class="px-5 py-2">${escapeHtml(b.payment_status ?? '')}</td>
						</tr>`).join('')}
				</tbody>
			</table>`;
	}

	function render() {
		if (!affiliates.length) {
			rowsEl.innerHTML = '<tr><td colspan="9" class="px-5 py-8 text-center text-neutral-400">No affiliates yet.</td></tr>';
			return;
		}

		rowsEl.innerHTML = affiliates.map((i) => {
			const t = totalsFor(i);
			const isOpen = expanded.has(i.id);
			return `
				<tr class="border-t border-neutral-100">
					<td class="px-5 py-3">
						<span class="font-semibold text-neutral-900">${escapeHtml(i.name)}</span>
						${i.email ? `<span class="block text-xs text-neutral-400">${escapeHtml(i.email)}</span>` : ''}
					</td>
					<td class="px-5 py-3 whitespace-nowrap">
						<span class="font-mono text-xs text-neutral-600">?ref=${escapeHtml(i.ref_code)}</span>
						<button data-copy="${i.id}" class="ml-1 px-2 py-1 text-xs font-semibold rounded-lg border border-neutral-200 hover:bg-sky-50 text-neutral-600">Copy link</button>
					</td>
					<td class="px-5 py-3 whitespace-nowrap">
						<span class="rate-cell cursor-pointer hover:bg-sky-50 px-2 py-1 rounded-lg" data-rate="${i.id}" title="Click to edit commission">${escapeHtml(rateLabel(i))}</span>
					</td>
					<td class="px-5 py-3">
						<button data-expand="${i.id}" class="px-2.5 py-1 text-xs font-semibold rounded-lg border ${isOpen ? 'border-[#0C6B95] text-[#0C6B95] bg-sky-50' : 'border-neutral-200 text-neutral-700 hover:bg-sky-50'}">
							${t.count} ${isOpen ? '▴' : '▾'}
						</button>
					</td>
					<td class="px-5 py-3">${eur(t.revenue)}</td>
					<td class="px-5 py-3 font-semibold text-emerald-700">${eur(t.commission)}</td>
					<td class="px-5 py-3"><span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${i.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${i.active ? 'active' : 'closed'}</span></td>
					<td class="px-5 py-3 whitespace-nowrap">
						${i.user_id
							? `<span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-700" title="${escapeHtml(i.email || '')}">Has login</span>`
							: `<button data-login="${i.id}" data-name="${escapeHtml(i.name)}" data-email="${escapeHtml(i.email || '')}" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[#0C6B95] text-[#0C6B95] hover:bg-sky-50">Create login</button>`}
					</td>
					<td class="px-5 py-3 text-right whitespace-nowrap">
						<button data-toggle="${i.id}" data-active="${i.active}" class="px-3 py-1.5 text-xs font-semibold rounded-lg border ${i.active ? 'border-amber-300 text-amber-700 hover:bg-amber-50' : 'border-green-300 text-green-700 hover:bg-green-50'}">
							${i.active ? 'Close' : 'Reopen'}
						</button>
						<button data-delete="${i.id}" data-name="${escapeHtml(i.name)}" class="ml-2 px-3 py-1.5 text-xs font-semibold rounded-lg border border-red-300 text-red-600 hover:bg-red-50">
							Delete
						</button>
					</td>
				</tr>
				${isOpen ? `<tr class="border-t border-neutral-100 bg-neutral-50/60"><td colspan="9" class="p-0">${bookingsDetailHtml(i)}</td></tr>` : ''}`;
		}).join('');

		wireRowActions();
	}

	function wireRowActions() {
		rowsEl.querySelectorAll<HTMLButtonElement>('[data-iban]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(btn.dataset.iban!);
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = 'Copy IBAN'; }, 1500);
				} catch { setStatus(`IBAN: ${btn.dataset.iban}`, 'text-neutral-600'); }
			});
		});
		rowsEl.querySelectorAll<HTMLButtonElement>('[data-login]').forEach((btn) => {
			btn.addEventListener('click', () => openLoginModal(btn.dataset.login!, btn.dataset.name ?? '', btn.dataset.email ?? ''));
		});
		rowsEl.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const aff = affiliates.find((x) => x.id === btn.dataset.copy);
				if (!aff) return;
				try {
					await navigator.clipboard.writeText(refUrl(aff));
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = 'Copy link'; }, 1500);
				} catch {
					setStatus(`Link: ${refUrl(aff)}`, 'text-neutral-600');
				}
			});
		});

		rowsEl.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.expand ?? '';
				if (expanded.has(id)) expanded.delete(id); else expanded.add(id);
				render();
			});
		});

		rowsEl.querySelectorAll<HTMLSpanElement>('.rate-cell').forEach((cell) => {
			cell.addEventListener('click', () => {
				const aff = affiliates.find((x) => x.id === cell.dataset.rate);
				if (!aff) return;
				cell.outerHTML = `
					<span class="inline-flex items-center gap-1">
						<select id="rate-type-${aff.id}" class="rounded-lg border border-neutral-200 px-1.5 py-1 text-xs">
							<option value="percent" ${aff.commission_type === 'percent' ? 'selected' : ''}>%</option>
							<option value="fixed" ${aff.commission_type === 'fixed' ? 'selected' : ''}>€</option>
						</select>
						<input id="rate-value-${aff.id}" type="number" min="0" step="0.01" value="${aff.commission_value}"
							class="w-20 rounded-lg border border-neutral-200 px-2 py-1 text-xs" />
						<button id="rate-save-${aff.id}" class="px-2 py-1 bg-[#0C6B95] text-white text-xs rounded-lg hover:bg-[#0a5c82]">Save</button>
					</span>`;
				document.getElementById(`rate-save-${aff.id}`)?.addEventListener('click', async () => {
					const type = (document.getElementById(`rate-type-${aff.id}`) as HTMLSelectElement).value as 'percent' | 'fixed';
					const val = parseFloat((document.getElementById(`rate-value-${aff.id}`) as HTMLInputElement).value);
					if (!Number.isFinite(val) || val < 0) { setStatus('Commission value must be 0 or more.', 'text-red-500'); return; }
					if (type === 'percent' && val > 100) { setStatus('Percent commission cannot exceed 100.', 'text-red-500'); return; }
					const { error } = await supabase.from('influencers')
						.update({ commission_type: type, commission_value: val })
						.eq('id', aff.id);
					if (error) { setStatus(`Error updating commission: [${error.code}] ${error.message}`, 'text-red-500'); return; }
					setStatus(`Commission updated for "${aff.name}". Applies to new bookings only.`, 'text-green-600');
					await loadData();
				});
			});
		});

		rowsEl.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				btn.disabled = true;
				const { error } = await supabase.from('influencers')
					.update({ active: btn.dataset.active !== 'true' })
					.eq('id', btn.dataset.toggle);
				if (error) setStatus(`Error updating affiliate: [${error.code}] ${error.message}`, 'text-red-500');
				await loadData();
			});
		});

		rowsEl.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
			btn.addEventListener('click', () => {
				pendingDeleteId = btn.dataset.delete ?? null;
				const nameEl = document.getElementById('aff-delete-name');
				if (nameEl) nameEl.textContent = btn.dataset.name ?? '';
				document.getElementById('aff-delete-modal')?.classList.remove('hidden');
			});
		});
	}

	/* ── Create ── */
	document.getElementById('aff-form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const name = (document.getElementById('aff-name') as HTMLInputElement).value.trim();
		const refCode = (document.getElementById('aff-code') as HTMLInputElement).value.trim();
		const email = (document.getElementById('aff-email') as HTMLInputElement).value.trim();
		const password = (document.getElementById('aff-password') as HTMLInputElement).value;
		const cType = (document.getElementById('aff-ctype') as HTMLSelectElement).value as 'percent' | 'fixed';
		const cValue = parseFloat((document.getElementById('aff-cvalue') as HTMLInputElement).value);

		if (!name) { setStatus('Enter a name.', 'text-red-500'); return; }
		if (!/^[a-zA-Z0-9_-]{3,32}$/.test(refCode)) { setStatus('Referral code must be 3-32 letters, numbers, - or _.', 'text-red-500'); return; }
		if (!email) { setStatus('Enter an email — it is their login.', 'text-red-500'); return; }
		if (password.length < 8) { setStatus('Password must be at least 8 characters.', 'text-red-500'); return; }
		if (!Number.isFinite(cValue) || cValue < 0) { setStatus('Commission value must be 0 or more.', 'text-red-500'); return; }
		if (cType === 'percent' && cValue > 100) { setStatus('Percent commission cannot exceed 100.', 'text-red-500'); return; }

		setStatus('Creating…', 'text-[#0C6B95]');

		// Two steps: the profile row (RLS-authorized insert), then the login
		// (server route — creating an auth user needs the service role). If the
		// second step fails the profile still exists, so the admin can retry with
		// the row's "Create login" button instead of starting over.
		const { data: created, error } = await supabase.from('influencers').insert({
			name,
			ref_code: refCode,
			email,
			commission_type: cType,
			commission_value: cValue,
			active: true,
		}).select('id').single();

		if (error || !created) {
			const msg = error?.code === '23505'
				? `The referral code "${refCode}" is already taken.`
				: `Error creating affiliate: [${error?.code}] ${error?.message}`;
			setStatus(msg, 'text-red-500');
			return;
		}

		const loginErr = await createLogin(created.id, email, password);
		if (loginErr) {
			setStatus(`Affiliate "${name}" was created, but the login was not: ${loginErr} Use "Create login" on their row to retry.`, 'text-red-500');
			(document.getElementById('aff-password') as HTMLInputElement).value = '';
			await loadData();
			return;
		}

		setStatus(`Affiliate "${name}" created with a login.`, 'text-green-600');
		(e.target as HTMLFormElement).reset();
		await loadData();
	});

	/* ── Create login ── */
	// Password fields are write-only: typed by the admin, posted straight to the
	// server route, never stored or echoed back into the page.
	document.querySelectorAll<HTMLButtonElement>('[data-toggle-pw]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const input = document.getElementById(btn.dataset.togglePw!) as HTMLInputElement | null;
			if (!input) return;
			const hidden = input.type === 'password';
			input.type = hidden ? 'text' : 'password';
			btn.textContent = hidden ? 'Hide' : 'Show';
		});
	});

	const loginModal   = document.getElementById('aff-login-modal');
	const loginNameEl  = document.getElementById('aff-login-name');
	const loginEmailEl = document.getElementById('aff-login-email') as HTMLInputElement | null;
	const loginPwEl    = document.getElementById('aff-login-password') as HTMLInputElement | null;
	const loginStatus  = document.getElementById('aff-login-status');
	const loginConfirm = document.getElementById('aff-login-confirm') as HTMLButtonElement | null;
	let pendingLoginId: string | null = null;

	function setLoginStatus(msg: string, cls: string) {
		if (!loginStatus) return;
		loginStatus.textContent = msg;
		loginStatus.className = `text-xs mb-4 ${cls}`;
	}

	function openLoginModal(id: string, name: string, email: string) {
		pendingLoginId = id;
		if (loginNameEl) loginNameEl.textContent = name;
		if (loginEmailEl) loginEmailEl.value = email;
		if (loginPwEl) loginPwEl.value = '';
		setLoginStatus('', '');
		loginModal?.classList.remove('hidden');
		loginEmailEl?.focus();
	}

	function closeLoginModal() {
		pendingLoginId = null;
		if (loginPwEl) loginPwEl.value = '';   // never leave a password in the DOM
		loginModal?.classList.add('hidden');
	}

	document.getElementById('aff-login-cancel')?.addEventListener('click', closeLoginModal);
	loginModal?.addEventListener('click', (e) => { if (e.target === loginModal) closeLoginModal(); });

	/** Calls the admin-only server route. Returns an error message, or null on success. */
	async function createLogin(affiliateId: string, email: string, password: string): Promise<string | null> {
		const { data: { session } } = await supabase.auth.getSession();
		if (!session?.access_token) return 'Your session expired — reload and sign in again.';
		let res: Response;
		try {
			res = await fetch('/api/admin/create-affiliate-login', {
				method: 'POST',
				headers: { 'content-type': 'application/json', authorization: `Bearer ${session.access_token}` },
				body: JSON.stringify({ affiliateId, email, password }),
			});
		} catch {
			return 'Could not reach the server.';
		}
		if (res.ok) return null;
		const body = await res.json().catch(() => ({}));
		return body?.error || `Request failed (${res.status})`;
	}

	loginConfirm?.addEventListener('click', async () => {
		if (!pendingLoginId || !loginEmailEl || !loginPwEl) return;
		const email = loginEmailEl.value.trim();
		const password = loginPwEl.value;
		if (!email) { setLoginStatus('Enter an email address.', 'text-red-500'); return; }
		if (password.length < 8) { setLoginStatus('Password must be at least 8 characters.', 'text-red-500'); return; }

		loginConfirm.disabled = true;
		setLoginStatus('Creating…', 'text-[#0C6B95]');
		const err = await createLogin(pendingLoginId, email, password);
		loginConfirm.disabled = false;
		if (err) { setLoginStatus(err, 'text-red-500'); return; }

		closeLoginModal();
		setStatus('Login created.', 'text-green-600');
		await loadData();
	});

	/* ── Delete modal ── */
	document.getElementById('aff-delete-cancel')?.addEventListener('click', () => {
		pendingDeleteId = null;
		document.getElementById('aff-delete-modal')?.classList.add('hidden');
	});
	document.getElementById('aff-delete-confirm')?.addEventListener('click', async () => {
		if (!pendingDeleteId) return;
		const { error } = await supabase.from('influencers').delete().eq('id', pendingDeleteId);
		if (error) setStatus(`Error deleting affiliate: [${error.code}] ${error.message}`, 'text-red-500');
		pendingDeleteId = null;
		document.getElementById('aff-delete-modal')?.classList.add('hidden');
		await loadData();
	});

	/* ── Wait for the AdminLayout auth gate, then load ── */
	const authEl = document.getElementById('admin-auth-check');
	if (authEl) {
		if (authEl.classList.contains('hidden')) loadData();
		else {
			const observer = new MutationObserver(() => {
				if (authEl.classList.contains('hidden')) { observer.disconnect(); loadData(); }
			});
			observer.observe(authEl, { attributes: true, attributeFilter: ['class'] });
		}
	} else {
		loadData();
	}
</script>
