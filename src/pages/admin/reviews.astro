---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout pageTitle="Google Reviews" pageDescription="Reviews pulled from the Google Business Profile. Nothing shows on the site until you approve it here. Pin the ones you want first, hide or delete the rest." activeSection="reviews" docTitle="Google Reviews — Admin">
	<div class="max-w-5xl">

		<!-- ── Summary + sync ── -->
		<div class="bg-white rounded-2xl border border-neutral-200 shadow-sm p-6 mb-6 flex flex-col md:flex-row md:items-center gap-4">
			<div class="flex items-center gap-4 flex-1">
				<div class="w-14 h-14 rounded-2xl bg-[#F5F6F8] flex items-center justify-center shrink-0">
					<svg class="w-7 h-7" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.4 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9l3.3-2.5z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5L6.4 10C7.2 7.8 9.4 6 12 6z"/></svg>
				</div>
				<div>
					<p class="text-2xl font-bold text-neutral-900 leading-none"><span id="rv-rating">—</span> <span id="rv-stars" class="text-amber-400 text-lg align-middle"></span></p>
					<p class="text-sm text-neutral-500 mt-1"><span id="rv-total">—</span> reviews on Google · <span id="rv-approved">0</span> on the site</p>
					<p class="text-xs text-neutral-400 mt-1" id="rv-last-sync">Never synced.</p>
				</div>
			</div>
			<div class="flex items-center gap-3">
				<a id="rv-place-link" href="#" target="_blank" rel="noopener noreferrer" class="hidden text-sm font-medium text-[#0C6B95] hover:underline">Open on Google ↗</a>
				<button id="rv-sync" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-xl bg-[#0C6B95] hover:bg-[#0a5c82] text-white disabled:opacity-60">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.6 9A7 7 0 0 1 18 7.5M18.4 15A7 7 0 0 1 6 16.5" /></svg>
					Sync now
				</button>
			</div>
		</div>
		<p id="rv-status" class="text-sm mb-4 min-h-[1.25rem]"></p>

		<!-- ── Filter tabs ── -->
		<div class="flex flex-wrap items-center gap-2 mb-4" id="rv-tabs">
			<button type="button" data-tab="pending"  class="rv-tab px-4 py-2 text-sm font-semibold rounded-xl border">Pending <span class="rv-tab-count opacity-80"></span></button>
			<button type="button" data-tab="approved" class="rv-tab px-4 py-2 text-sm font-semibold rounded-xl border">On the site <span class="rv-tab-count opacity-80"></span></button>
			<button type="button" data-tab="hidden"   class="rv-tab px-4 py-2 text-sm font-semibold rounded-xl border">Hidden <span class="rv-tab-count opacity-80"></span></button>
			<button type="button" data-tab="deleted"  class="rv-tab px-4 py-2 text-sm font-semibold rounded-xl border">Trash <span class="rv-tab-count opacity-80"></span></button>
			<button type="button" data-tab="all"      class="rv-tab px-4 py-2 text-sm font-semibold rounded-xl border">All <span class="rv-tab-count opacity-80"></span></button>
		</div>

		<!-- ── Bulk bar ── -->
		<div class="flex flex-wrap items-center gap-2 mb-4 bg-white rounded-2xl border border-neutral-200 shadow-sm px-4 py-3">
			<label class="inline-flex items-center gap-2 text-sm text-neutral-600 cursor-pointer select-none">
				<input id="rv-select-all" type="checkbox" class="w-4 h-4 rounded border-neutral-300 accent-[#0C6B95]" />
				Select all shown
			</label>
			<span id="rv-selected-count" class="text-xs text-neutral-400 ml-1">0 selected</span>
			<div class="flex flex-wrap gap-2 ml-auto" id="rv-bulk">
				<button type="button" data-bulk="approved" class="rv-bulk px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white disabled:opacity-40" disabled>Approve selected</button>
				<button type="button" data-bulk="hidden"   class="rv-bulk px-3 py-1.5 text-xs font-semibold rounded-lg border border-neutral-200 text-neutral-700 hover:bg-neutral-50 disabled:opacity-40" disabled>Hide selected</button>
				<button type="button" data-bulk="deleted"  class="rv-bulk px-3 py-1.5 text-xs font-semibold rounded-lg border border-red-200 text-red-600 hover:bg-red-50 disabled:opacity-40" disabled>Delete selected</button>
			</div>
		</div>

		<!-- ── List ── -->
		<div id="rv-list" class="flex flex-col gap-3">
			<div class="bg-white rounded-2xl border border-neutral-200 px-5 py-10 text-center text-neutral-400 text-sm">Loading…</div>
		</div>
	</div>

	<!-- ── Delete-forever confirm modal ── -->
	<div id="rv-purge-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
		<div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm">
			<h3 class="text-base font-bold text-neutral-900 mb-2">Delete forever?</h3>
			<p class="text-sm text-neutral-500 mb-5">This removes <strong id="rv-purge-count">1 review</strong> from the database. If Google still returns it, the next sync will bring it back as <em>pending</em> — use the Trash to keep it out of sight for good.</p>
			<div class="flex justify-end gap-3">
				<button id="rv-purge-cancel" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl border border-neutral-200 text-neutral-600 hover:bg-neutral-50">Cancel</button>
				<button id="rv-purge-confirm" type="button" class="px-4 py-2 text-sm font-semibold rounded-xl bg-red-600 hover:bg-red-700 text-white">Delete forever</button>
			</div>
		</div>
	</div>
</AdminLayout>

<script>
	import { supabase } from '../../lib/supabase';

	type ReviewStatus = 'pending' | 'approved' | 'hidden' | 'deleted';
	type ReviewRow = {
		id: string;
		author_name: string;
		author_url: string | null;
		author_photo_url: string | null;
		rating: number;
		text: string;
		language: string | null;
		published_at: string;
		google_maps_uri: string | null;
		status: ReviewStatus;
		featured: boolean;
		status_changed_at: string | null;
		first_seen_at: string;
	};
	type Tab = ReviewStatus | 'all';

	const listEl = document.getElementById('rv-list')!;
	const statusEl = document.getElementById('rv-status')!;
	const syncBtn = document.getElementById('rv-sync') as HTMLButtonElement;
	const selectAllEl = document.getElementById('rv-select-all') as HTMLInputElement;
	const selectedCountEl = document.getElementById('rv-selected-count')!;
	const purgeModal = document.getElementById('rv-purge-modal')!;
	let rows: ReviewRow[] = [];
	let tab: Tab = 'pending';
	const selected = new Set<string>();
	let purgeIds: string[] = [];

	function setStatus(msg: string, cls: string) {
		statusEl.textContent = msg;
		statusEl.className = `text-sm mb-4 min-h-[1.25rem] ${cls}`;
	}

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) => (
			{ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
		));
	}

	// Only http(s) URLs from Google are linked; anything else is dropped.
	function safeUrl(u: string | null): string | null {
		if (!u) return null;
		try {
			const parsed = new URL(u);
			return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.toString() : null;
		} catch { return null; }
	}

	const stars = (n: number) => '★'.repeat(Math.max(0, Math.min(5, n))) + '☆'.repeat(Math.max(0, 5 - Math.min(5, n)));

	const STATUS_BADGE: Record<ReviewStatus, string> = {
		pending:  'bg-amber-50 text-amber-700 border-amber-200',
		approved: 'bg-emerald-50 text-emerald-700 border-emerald-200',
		hidden:   'bg-neutral-100 text-neutral-500 border-neutral-200',
		deleted:  'bg-red-50 text-red-600 border-red-200',
	};
	const STATUS_LABEL: Record<ReviewStatus, string> = {
		pending: 'Pending', approved: 'On the site', hidden: 'Hidden', deleted: 'In trash',
	};

	const fmtDate = (iso: string) => {
		const d = new Date(iso);
		return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
	};

	function avatar(r: ReviewRow): string {
		const photo = safeUrl(r.author_photo_url);
		const initial = escapeHtml((r.author_name.trim()[0] || '?').toUpperCase());
		return photo
			? `<img src="${escapeHtml(photo)}" alt="" referrerpolicy="no-referrer" class="w-10 h-10 rounded-full object-cover bg-neutral-100 shrink-0" />`
			: `<span class="w-10 h-10 rounded-full bg-[#0C6B95]/10 text-[#0C6B95] font-bold flex items-center justify-center shrink-0">${initial}</span>`;
	}

	const btn = (action: string, id: string, label: string, cls: string) =>
		`<button type="button" data-action="${action}" data-id="${id}" class="px-3 py-1.5 text-xs font-semibold rounded-lg ${cls}">${label}</button>`;
	const PRIMARY = 'bg-emerald-600 hover:bg-emerald-700 text-white';
	const NEUTRAL = 'border border-neutral-200 text-neutral-600 hover:bg-neutral-50';
	const DANGER  = 'border border-red-200 text-red-600 hover:bg-red-50';

	function actionButtons(r: ReviewRow): string {
		const out: string[] = [];
		switch (r.status) {
			case 'pending':
				out.push(btn('approved', r.id, 'Approve', PRIMARY), btn('hidden', r.id, 'Hide', NEUTRAL), btn('deleted', r.id, 'Delete', DANGER));
				break;
			case 'approved':
				out.push(
					btn('toggle-featured', r.id, r.featured ? 'Unpin' : 'Pin to top', r.featured ? 'bg-amber-100 text-amber-800 hover:bg-amber-200' : NEUTRAL),
					btn('hidden', r.id, 'Remove from site', NEUTRAL),
					btn('deleted', r.id, 'Delete', DANGER),
				);
				break;
			case 'hidden':
				out.push(btn('approved', r.id, 'Put on the site', PRIMARY), btn('deleted', r.id, 'Delete', DANGER));
				break;
			case 'deleted':
				out.push(btn('pending', r.id, 'Restore', NEUTRAL), btn('purge', r.id, 'Delete forever', DANGER));
				break;
		}
		return out.join(' ');
	}

	function card(r: ReviewRow): string {
		const profile = safeUrl(r.author_url);
		const mapsLink = safeUrl(r.google_maps_uri);
		const name = profile
			? `<a href="${escapeHtml(profile)}" target="_blank" rel="noopener noreferrer" class="font-semibold text-neutral-900 hover:text-[#0C6B95]">${escapeHtml(r.author_name)}</a>`
			: `<span class="font-semibold text-neutral-900">${escapeHtml(r.author_name)}</span>`;
		const pinned = r.status === 'approved' && r.featured
			? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">📌 Pinned</span>` : '';
		return `
			<article class="bg-white rounded-2xl border ${selected.has(r.id) ? 'border-[#0C6B95]' : 'border-neutral-200'} shadow-sm p-5" data-row="${r.id}">
				<div class="flex items-start gap-4">
					<input type="checkbox" data-select="${r.id}" ${selected.has(r.id) ? 'checked' : ''} class="mt-3 w-4 h-4 rounded border-neutral-300 accent-[#0C6B95] shrink-0" aria-label="Select review" />
					${avatar(r)}
					<div class="flex-1 min-w-0">
						<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
							${name}
							<span class="text-amber-400 text-sm tracking-tight" aria-label="${r.rating} out of 5">${stars(r.rating)}</span>
							<span class="text-xs text-neutral-400">${escapeHtml(fmtDate(r.published_at))}${r.language ? ` · ${escapeHtml(r.language.toUpperCase())}` : ''}</span>
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${STATUS_BADGE[r.status]}">${STATUS_LABEL[r.status]}</span>
							${pinned}
						</div>
						<p class="text-sm text-neutral-700 mt-2 whitespace-pre-line break-words">${r.text ? escapeHtml(r.text) : '<span class="text-neutral-400 italic">No text — rating only.</span>'}</p>
						<div class="flex flex-wrap items-center gap-2 mt-3">
							${actionButtons(r)}
							${mapsLink ? `<a href="${escapeHtml(mapsLink)}" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-[#0C6B95] ml-auto">View on Google ↗</a>` : ''}
						</div>
					</div>
				</div>
			</article>`;
	}

	function visibleRows(): ReviewRow[] {
		if (tab === 'all') return rows.filter((r) => r.status !== 'deleted');
		return rows.filter((r) => r.status === tab);
	}

	function updateSelectionUi() {
		const visible = visibleRows();
		const shownSelected = visible.filter((r) => selected.has(r.id)).length;
		selectedCountEl.textContent = `${shownSelected} selected`;
		selectAllEl.checked = visible.length > 0 && shownSelected === visible.length;
		selectAllEl.indeterminate = shownSelected > 0 && shownSelected < visible.length;
		document.querySelectorAll<HTMLButtonElement>('.rv-bulk').forEach((b) => { b.disabled = shownSelected === 0; });
	}

	function render() {
		const counts: Record<Tab, number> = { pending: 0, approved: 0, hidden: 0, deleted: 0, all: 0 };
		for (const r of rows) { counts[r.status] += 1; if (r.status !== 'deleted') counts.all += 1; }
		document.querySelectorAll<HTMLButtonElement>('.rv-tab').forEach((b) => {
			const t = b.dataset.tab as Tab;
			const active = t === tab;
			b.className = `rv-tab px-4 py-2 text-sm font-semibold rounded-xl border ${active ? 'bg-[#0C6B95] text-white border-[#0C6B95]' : 'bg-white text-neutral-600 border-neutral-200 hover:bg-neutral-50'}`;
			const c = b.querySelector('.rv-tab-count');
			if (c) c.textContent = `(${counts[t]})`;
		});
		document.getElementById('rv-approved')!.textContent = String(counts.approved);

		const visible = visibleRows();
		if (!visible.length) {
			const msg = rows.length === 0
				? 'No reviews yet. Click "Sync now" to pull the latest from Google.'
				: tab === 'pending' ? 'Nothing waiting for approval.'
				: tab === 'deleted' ? 'The trash is empty.'
				: `Nothing here.`;
			listEl.innerHTML = `<div class="bg-white rounded-2xl border border-neutral-200 px-5 py-10 text-center text-neutral-400 text-sm">${msg}</div>`;
		} else {
			listEl.innerHTML = visible.map(card).join('');
		}
		updateSelectionUi();
	}

	async function loadMeta() {
		const { data } = await supabase.from('google_reviews_meta').select('*').eq('id', 1).maybeSingle();
		const ratingEl = document.getElementById('rv-rating')!;
		const starsEl = document.getElementById('rv-stars')!;
		const totalEl = document.getElementById('rv-total')!;
		const lastEl = document.getElementById('rv-last-sync')!;
		const link = document.getElementById('rv-place-link') as HTMLAnchorElement;
		if (!data) return;
		ratingEl.textContent = data.rating != null ? Number(data.rating).toFixed(1) : '—';
		starsEl.textContent = data.rating != null ? stars(Math.round(Number(data.rating))) : '';
		totalEl.textContent = data.user_ratings_total != null ? String(data.user_ratings_total) : '—';
		if (data.last_sync_at) {
			const when = new Date(data.last_sync_at).toLocaleString('en-GB');
			lastEl.textContent = data.last_sync_error
				? `Last sync ${when} — ${data.last_sync_error}`
				: `Last sync ${when} · ${data.last_sync_new} new`;
			lastEl.className = `text-xs mt-1 ${data.last_sync_error ? 'text-red-500' : 'text-neutral-400'}`;
		}
		const placeUrl = safeUrl(data.place_url);
		if (placeUrl) { link.href = placeUrl; link.classList.remove('hidden'); }
	}

	async function loadReviews() {
		const { data, error } = await supabase
			.from('google_reviews')
			.select('id, author_name, author_url, author_photo_url, rating, text, language, published_at, google_maps_uri, status, featured, status_changed_at, first_seen_at')
			.order('featured', { ascending: false })
			.order('published_at', { ascending: false });
		if (error) {
			console.error('google_reviews load failed:', error);
			listEl.innerHTML = `<div class="bg-white rounded-2xl border border-neutral-200 px-5 py-10 text-center text-red-500 text-sm">Could not load reviews: ${escapeHtml(error.message)}</div>`;
			return;
		}
		rows = (data ?? []) as ReviewRow[];
		for (const id of [...selected]) if (!rows.some((r) => r.id === id)) selected.delete(id);
		render();
	}

	async function load() {
		await Promise.all([loadMeta(), loadReviews()]);
	}

	/* ── Mutations ── */
	const DONE_MSG: Record<ReviewStatus, string> = {
		approved: 'On the site now.',
		hidden: 'Removed from the site.',
		deleted: 'Moved to the trash.',
		pending: 'Restored to pending.',
	};

	async function setStatusFor(ids: string[], status: ReviewStatus) {
		if (!ids.length) return;
		const patch: Record<string, unknown> = { status, status_changed_at: new Date().toISOString() };
		if (status !== 'approved') patch.featured = false;
		const { error } = await supabase.from('google_reviews').update(patch).in('id', ids);
		if (error) { setStatus(`Could not update: ${error.message}`, 'text-red-500'); return; }
		for (const r of rows) if (ids.includes(r.id)) { r.status = status; if (status !== 'approved') r.featured = false; }
		ids.forEach((id) => selected.delete(id));
		setStatus(`${ids.length === 1 ? 'Review' : `${ids.length} reviews`}: ${DONE_MSG[status]}`, 'text-green-600');
		render();
	}

	async function toggleFeatured(id: string) {
		const row = rows.find((r) => r.id === id);
		if (!row) return;
		const featured = !row.featured;
		const { error } = await supabase.from('google_reviews').update({ featured }).eq('id', id);
		if (error) { setStatus(`Could not update: ${error.message}`, 'text-red-500'); return; }
		row.featured = featured;
		setStatus(featured ? 'Pinned — it shows first on the site.' : 'Unpinned.', 'text-green-600');
		render();
	}

	async function purge(ids: string[]) {
		if (!ids.length) return;
		const { error } = await supabase.from('google_reviews').delete().in('id', ids);
		if (error) { setStatus(`Could not delete: ${error.message}`, 'text-red-500'); return; }
		rows = rows.filter((r) => !ids.includes(r.id));
		ids.forEach((id) => selected.delete(id));
		setStatus(`${ids.length === 1 ? 'Review' : `${ids.length} reviews`} deleted forever.`, 'text-green-600');
		render();
	}

	function openPurge(ids: string[]) {
		purgeIds = ids;
		document.getElementById('rv-purge-count')!.textContent = ids.length === 1 ? '1 review' : `${ids.length} reviews`;
		purgeModal.classList.remove('hidden');
	}
	function closePurge() { purgeIds = []; purgeModal.classList.add('hidden'); }
	document.getElementById('rv-purge-cancel')!.addEventListener('click', closePurge);
	document.getElementById('rv-purge-confirm')!.addEventListener('click', async () => { const ids = purgeIds; closePurge(); await purge(ids); });
	purgeModal.addEventListener('click', (e) => { if (e.target === purgeModal) closePurge(); });
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !purgeModal.classList.contains('hidden')) closePurge(); });

	/* ── Tabs ── */
	document.getElementById('rv-tabs')?.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.rv-tab');
		if (!b) return;
		tab = b.dataset.tab as Tab;
		render();
	});

	/* ── Row actions + selection ── */
	listEl.addEventListener('click', async (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
		if (!b) return;
		const id = b.dataset.id!;
		const action = b.dataset.action!;
		b.disabled = true;
		if (action === 'toggle-featured') await toggleFeatured(id);
		else if (action === 'purge') { b.disabled = false; openPurge([id]); }
		else await setStatusFor([id], action as ReviewStatus);
	});
	listEl.addEventListener('change', (e) => {
		const cb = e.target as HTMLInputElement;
		if (!cb.matches('input[data-select]')) return;
		const id = cb.dataset.select!;
		if (cb.checked) selected.add(id); else selected.delete(id);
		cb.closest('article')?.classList.toggle('border-[#0C6B95]', cb.checked);
		cb.closest('article')?.classList.toggle('border-neutral-200', !cb.checked);
		updateSelectionUi();
	});
	selectAllEl.addEventListener('change', () => {
		const visible = visibleRows();
		if (selectAllEl.checked) visible.forEach((r) => selected.add(r.id)); else visible.forEach((r) => selected.delete(r.id));
		render();
	});

	/* ── Bulk actions (on the rows shown in the current tab) ── */
	document.getElementById('rv-bulk')?.addEventListener('click', async (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.rv-bulk');
		if (!b || b.disabled) return;
		const ids = visibleRows().filter((r) => selected.has(r.id)).map((r) => r.id);
		if (!ids.length) return;
		const status = b.dataset.bulk as ReviewStatus;
		// In the trash, "Delete selected" means delete forever.
		if (status === 'deleted' && tab === 'deleted') { openPurge(ids); return; }
		await setStatusFor(ids, status);
	});

	/* ── Sync now ── */
	syncBtn.addEventListener('click', async () => {
		const { data: { session } } = await supabase.auth.getSession();
		if (!session) { setStatus('Not signed in.', 'text-red-500'); return; }
		syncBtn.disabled = true;
		setStatus('Syncing with Google…', 'text-neutral-500');
		try {
			// JSON content type, like the other admin routes: Astro's built-in
			// origin check treats a body-less POST as a form post and answers 403
			// behind Vercel, where the request origin is not the public host.
			const res = await fetch('/api/admin/sync-google-reviews', {
				method: 'POST',
				headers: { 'content-type': 'application/json', authorization: `Bearer ${session.access_token}` },
				body: '{}',
			});
			const body = await res.json().catch(() => ({}));
			if (!res.ok || !body.ok) {
				const why = Array.isArray(body.errors) && body.errors.length ? body.errors.join(' | ') : (body.error || `HTTP ${res.status}`);
				setStatus(`Sync failed: ${why}`, 'text-red-500');
			} else {
				const warn = Array.isArray(body.errors) && body.errors.length ? ` (${body.errors.join(' | ')})` : '';
				setStatus(`Sync done: ${body.new} new, ${body.seen} seen from Google.${warn}`, body.new > 0 ? 'text-green-600' : 'text-neutral-500');
				if (body.new > 0) tab = 'pending';
			}
		} catch (err) {
			setStatus(`Sync failed: ${err instanceof Error ? err.message : String(err)}`, 'text-red-500');
		}
		syncBtn.disabled = false;
		await load();
	});

	/* ── Wait for the AdminLayout auth gate, then load ── */
	const authEl = document.getElementById('admin-auth-check');
	if (authEl) {
		if (authEl.classList.contains('hidden')) load();
		else {
			const observer = new MutationObserver(() => {
				if (authEl.classList.contains('hidden')) { observer.disconnect(); load(); }
			});
			observer.observe(authEl, { attributes: true, attributeFilter: ['class'] });
		}
	} else {
		load();
	}
</script>
