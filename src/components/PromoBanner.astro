---
// src/components/PromoBanner.astro
//
// Sticky promo bar pinned to the bottom of the viewport.
// Behaviour: position:sticky + bottom:0 inside the wrapper in Layout.astro that
// ends where the footer begins — so it follows the visitor while they scroll and
// parks in its natural slot right above the footer once they reach it.
// It stays off-screen while the hero fills the viewport and slides in as soon as
// the visitor has scrolled far enough for a gap the height of the bar to open up
// below the hero; pages with no hero (no [data-promo-anchor]) show it right away.
---
<aside
	id="promo-banner"
	class="sticky bottom-0 z-30 translate-y-full pointer-events-none transition-transform duration-300 ease-out motion-reduce:transition-none bg-[#0C6B95] text-white font-sans shadow-[0_-8px_24px_-12px_rgba(12,107,149,0.45)]"
	aria-label="Opawey offer"
>
	<div class="max-w-6xl mx-auto px-6 lg:px-10 py-3 md:py-4 flex items-center gap-4">
		<div class="flex-1 min-w-0 flex flex-wrap items-center gap-x-3 gap-y-1">
			<span
				class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-white/15 border border-white/25 whitespace-nowrap"
				data-i18n-el="Νέο"
				data-i18n-es="Nuevo"
			>New</span>
			<p id="promo-default-copy" class="text-base md:text-lg font-semibold leading-tight">
				<span data-i18n-el="Κλείστε online τη μεταφορά σας:" data-i18n-es="Reserva tu traslado online:">Book your transfer online:</span>
				<span
					class="font-normal text-white/90"
					data-i18n-el="ιδιωτικός οδηγός σε όλη την Ελλάδα, με σταθερή τιμή."
					data-i18n-es="chófer privado en toda Grecia, con precio fijo."
				>private chauffeur across Greece, at a fixed price.</span>
			</p>
			<p id="promo-coupon-copy" class="hidden text-base md:text-lg font-semibold leading-tight">
				<span id="promo-coupon-text"></span>
				<span class="ml-2 inline-flex items-center gap-1.5 align-middle">
					<span class="text-xs font-normal text-white/70" data-i18n-el="Κωδικός" data-i18n-es="Código">Code</span>
					<span id="promo-coupon-code" class="px-2 py-0.5 rounded bg-white/15 border border-white/30 font-mono text-sm tracking-wide"></span>
				</span>
			</p>
		</div>
		<a
			href="/book"
			class="hidden sm:inline-flex shrink-0 items-center gap-1.5 bg-white text-[#0C6B95] font-semibold rounded-lg px-4 py-2 text-sm hover:bg-white/90 transition-colors no-underline"
		>
			<span data-i18n-el="Κάντε κράτηση" data-i18n-es="Reservar ahora">Book now</span>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
		</a>
		<a
			href="/book"
			class="inline-flex sm:hidden shrink-0 items-center bg-white text-[#0C6B95] font-semibold rounded-lg px-3 py-2 text-sm no-underline"
			aria-label="Book now"
			data-i18n-aria-el="Κάντε κράτηση"
			data-i18n-aria-es="Reservar ahora"
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
		</a>
	</div>
</aside>

<script>
	import { fetchPromoBanner } from '../lib/promo-banner';

	// Runs on every astro:page-load — view transitions swap the <body>, so the
	// banner element is a new node after each client-side navigation.
	let teardownPromo: (() => void) | null = null;

	function initPromoBanner() {
		teardownPromo?.();
		teardownPromo = null;

		const banner = document.getElementById('promo-banner');
		if (!banner) return;

		// Swap in the running coupon offer, if one is being advertised. Visibility
		// stays main's scroll concern; this only changes what the bar says.
		fetchPromoBanner().then((promo) => {
			if (!promo) return;
			const textEl = document.getElementById('promo-coupon-text');
			const codeEl = document.getElementById('promo-coupon-code');
			if (!textEl || !codeEl) return;
			textEl.textContent = promo.banner_text;
			codeEl.textContent = promo.code;
			document.getElementById('promo-default-copy')?.classList.add('hidden');
			document.getElementById('promo-coupon-copy')?.classList.remove('hidden');
		});

		// Reveal/conceal by sliding, so the bar never covers the hero.
		const show = (on: boolean) => {
			banner.classList.toggle('translate-y-full', !on);
			banner.classList.toggle('pointer-events-none', !on);
		};

		const anchor = document.querySelector('[data-promo-anchor]');
		if (!anchor) {
			// No hero on this page — the bar is relevant from the start.
			show(true);
			return;
		}

		// Show as soon as the strip of page below the hero is at least as tall as the
		// bar itself — i.e. the bar slides in over content, never over the hero.
		let queued = false;
		const update = () => {
			queued = false;
			const gapBelowHero = window.innerHeight - anchor.getBoundingClientRect().bottom;
			show(gapBelowHero >= banner.offsetHeight);
		};
		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		};

		update();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		teardownPromo = () => {
			window.removeEventListener('scroll', onScroll);
			window.removeEventListener('resize', onScroll);
		};
	}

	document.addEventListener('astro:page-load', initPromoBanner);
	document.addEventListener('astro:before-swap', () => {
		teardownPromo?.();
		teardownPromo = null;
	});
</script>
