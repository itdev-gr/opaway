---
// Reservation detail modal — opened via window.OpawayReservationDetail.open(row, kind)
// kind: 'transfer' | 'tour' | 'experience' | 'request'
// View mode renders the row read-only; "Edit" switches to a full form built from
// src/lib/booking-edit.ts and saves via a direct admin update (RLS: is_admin()).
---

<div id="res-detail-modal" class="fixed inset-0 z-[60] hidden">
	<div class="absolute inset-0 bg-black/40" id="res-detail-overlay"></div>
	<div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
		<div id="res-detail-card" class="bg-white rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 md:p-8 relative pointer-events-auto">
			<button type="button" id="res-detail-close"
				class="absolute top-4 right-4 text-neutral-400 hover:text-neutral-600 transition-colors">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
			<h3 id="res-detail-title" class="text-lg font-bold text-neutral-900 mb-2">Reservation</h3>
			<p id="res-detail-ref" class="text-xs font-mono text-neutral-500 mb-5"></p>
			<div id="res-detail-body" class="space-y-5 text-sm"></div>
			<div id="res-detail-footer" class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-end gap-2">
				<span id="res-detail-status" class="mr-auto text-xs hidden"></span>
				<button type="button" id="res-detail-edit"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0C6B95] hover:bg-[#0a5c82] text-white text-sm font-semibold transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
					Edit
				</button>
				<button type="button" id="res-detail-delete"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-red-200 text-red-600 text-sm font-semibold hover:bg-red-50 transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
					Delete booking
				</button>
				<button type="button" id="res-detail-cancel"
					class="hidden px-4 py-2 rounded-xl border border-neutral-200 text-neutral-700 text-sm font-semibold hover:bg-neutral-50 transition-colors">
					Cancel
				</button>
				<button type="button" id="res-detail-save"
					class="hidden px-4 py-2 rounded-xl bg-[#0C6B95] hover:bg-[#0a5c82] text-white text-sm font-semibold disabled:opacity-60 transition-colors">
					Save changes
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import { supabase } from '../lib/supabase';
	import { fieldsFor, buildUpdatePayload, VEHICLE_OPTIONS, type FieldDef, type Kind, type Option, type DynamicSource } from '../lib/booking-edit';
	import { fetchApprovedDrivers, buildAssignmentUpdate } from '../lib/driver-options';
	import { isPastBookingDate } from '../lib/booking-date';
	import { attachPlacesAutocomplete } from '../lib/places-autocomplete';

	type Row = Record<string, any>;

	const esc = (s: string) => String(s)
		.replace(/&/g, '&amp;').replace(/</g, '&lt;')
		.replace(/>/g, '&gt;').replace(/"/g, '&quot;');

	function field(label: string, value: any, opts: { full?: boolean } = {}) {
		if (value == null || value === '') return '';
		const str = typeof value === 'string' ? value : String(value);
		return `<div class="${opts.full ? 'col-span-2' : ''}">
			<div class="text-[11px] uppercase tracking-wider text-neutral-500 mb-0.5">${esc(label)}</div>
			<div class="${opts.full ? 'whitespace-pre-wrap' : ''} text-neutral-800">${esc(str)}</div>
		</div>`;
	}

	const money = (n: any) => (n == null || n === '' || Number.isNaN(Number(n)))
		? ''
		: `€${Number(n).toFixed(2)}`;

	/* ══════════════════ View mode ══════════════════ */

	function renderTransfer(r: Row) {
		return `<div class="grid grid-cols-2 gap-4">
			${field('Customer', [r.first_name, r.last_name].filter(Boolean).join(' ') || r.name)}
			${field('Email', r.email)}
			${field('Phone', r.phone)}
			${field('Booking type', r.booking_type)}
			${field('From', r.from)}
			${field('To', r.to)}
			${field('Date', r.date)}
			${field('Time', r.time)}
			${field('Return', r.return_date ? `${r.return_date} ${r.return_time ?? ''}`.trim() : '')}
			${field('Passengers', r.passengers)}
			${field('Luggage', (r.luggage_small || r.luggage_big) ? `${r.luggage_small || 0} small · ${r.luggage_big || 0} big` : '')}
			${field('Child seats', r.child_seats)}
			${field('Vehicle', r.vehicle_name || r.vehicle_slug)}
			${field('Hours', r.hours)}
			${field('€ / hour', r.per_hour ? money(r.per_hour) : '')}
			${field('Total price', money(r.total_price))}
			${field('Base price', money(r.base_price))}
			${field('Outward price', money(r.outward_price))}
			${field('Return price', money(r.return_price))}
			${field('Card surcharge', money(r.card_surcharge))}
			${field('Coupon', r.coupon_code ? `${r.coupon_code} (−${money(r.coupon_discount)})` : '')}
			${field('Affiliate', r.influencer_code ? `${r.influencer_code} (${money(r.influencer_commission)})` : '')}
			${field('Payment method', r.payment_method)}
			${field('Payment status', r.payment_status)}
			${field('Ride status', r.ride_status)}
			${field('Driver', r.driver || '—')}
			${field('Released to drivers', r.released_to_drivers ? 'Yes' : 'No')}
			${field('Customer notes', r.notes, { full: true })}
			${field('Driver notes', r.driver_notes, { full: true })}
			${field('Driver remarks', r.driver_remarks, { full: true })}
			${field('Sign name', r.sign_name)}
			${field('Created', r.created_at)}
		</div>`;
	}

	function renderTourOrExperience(r: Row, kind: 'tour' | 'experience') {
		const labelWord = kind === 'tour' ? 'Tour' : 'Experience';
		const tCount = Number(r.entrance_tickets_count) || 0;
		const tTotal = Number(r.entrance_tickets_total) || 0;
		const tickets = tCount > 0 ? `${tCount} × €${(tTotal / tCount).toFixed(2)} = €${tTotal.toFixed(2)}` : '';
		return `<div class="grid grid-cols-2 gap-4">
			${field('Customer', r.name || [r.first_name, r.last_name].filter(Boolean).join(' '))}
			${field('Email', r.email)}
			${field('Phone', r.phone)}
			${field(labelWord, r[`${kind}_name`] || r[kind])}
			${field('Pickup', r.pickup || r.pickup_location)}
			${field('Destination', r.destination)}
			${field('Date', r.date)}
			${field('Time', r.time)}
			${field('Participants', r.participants ?? r.passengers)}
			${field('Entrance tickets', tickets)}
			${field('Vehicle', r.vehicle || r.vehicle_name)}
			${field('Total price', money(r.total_price))}
			${field('Card surcharge', r.card_surcharge ? money(r.card_surcharge) : '')}
			${field('Coupon', r.coupon_code ? `${r.coupon_code} (−${money(r.coupon_discount)})` : '')}
			${field('Affiliate', r.influencer_code ? `${r.influencer_code} (${money(r.influencer_commission)})` : '')}
			${field('Payment method', r.payment_method)}
			${field('Payment status', r.payment_status)}
			${field('Ride status', r.ride_status)}
			${field('Driver', r.driver || '—')}
			${field('Released to drivers', r.released_to_drivers ? 'Yes' : 'No')}
			${field('Hotel preference', r.hotel_choice === 'self-book' ? 'Guest books their own hotel' : r.hotel_choice === 'include-booking' ? 'Wants hotel booked by agent' : '')}
			${kind === 'experience' ? field('Last name', r.last_name) : ''}
			${kind === 'experience' ? field('Source', r.source ? String(r.source).charAt(0).toUpperCase() + String(r.source).slice(1) : '') : ''}
			${kind === 'experience' ? field('Account name', r.user_display_name) : ''}
			${kind === 'experience' && r.user_email && r.user_email !== r.email ? field('Account email', r.user_email) : ''}
			${kind === 'experience' ? field('Submitted by', r.user_id ? 'Logged-in user' : 'Guest') : ''}
			${field('Special requests', r.special_requests, { full: true })}
			${field('Notes', r.notes, { full: true })}
			${field('Driver remarks', r.driver_remarks, { full: true })}
			${field('Added by admin', r.added_by_admin ? 'Yes' : 'No')}
			${field('Created', r.created_at)}
		</div>`;
	}

	function renderRequest(r: Row) {
		const sourceLabel = r.source ? String(r.source).charAt(0).toUpperCase() + String(r.source).slice(1) : '';
		const statusLabel = r.status === 'follow-up'
			? 'Follow up'
			: (r.status ? String(r.status).charAt(0).toUpperCase() + String(r.status).slice(1) : '');
		const fullName = [r.name, r.last_name].filter(Boolean).join(' ');

		// Per-source field set — empty values are auto-hidden by field().
		const isContact    = r.source === 'contact';
		const isTour       = r.source === 'tour';
		const isExperience = r.source === 'experience';

		return `<div class="grid grid-cols-2 gap-4">
			${field('Source', sourceLabel)}
			${field('Status', statusLabel)}
			${field('Created', r.created_at)}
			${field('Name', fullName)}
			${field('Email', r.email)}
			${field('Phone', r.phone)}
			${isContact ? field('Country', r.country) : ''}
			${isContact ? field('City', r.city) : ''}
			${isContact ? field('Passengers', r.participants) : ''}
			${isContact ? field('Vehicle type', r.vehicle_type) : ''}
			${isContact ? field('Subject', r.subject) : ''}
			${isContact ? field('Message', r.message, { full: true }) : ''}
			${isTour ? field('Tour', r.tour_name) : ''}
			${isTour ? field('Pickup', r.pickup_location) : ''}
			${isTour ? field('Date', r.date) : ''}
			${isTour ? field('Time', r.time) : ''}
			${isTour ? field('Participants', r.participants) : ''}
			${isTour ? field('Contact info', r.contact_info) : ''}
			${isTour ? field('Special requests', r.special_requests, { full: true }) : ''}
			${isExperience ? field('Experience', r.experience_name) : ''}
			${isExperience ? field('Pickup', r.pickup_location) : ''}
			${isExperience ? field('Date', r.date) : ''}
			${isExperience ? field('Time', r.time) : ''}
			${isExperience ? field('Participants', r.participants) : ''}
			${isExperience ? field('Special requests', r.special_requests, { full: true }) : ''}
			${field('Account name', r.user_display_name)}
			${r.user_email && r.user_email !== r.email ? field('Account email', r.user_email) : ''}
			${field('Submitted by', r.user_id ? 'Logged-in user' : 'Guest')}
		</div>`;
	}

	/* ══════════════════ Edit mode ══════════════════ */

	type Sources = Record<DynamicSource, Option[]>;
	let sourcesPromise: Promise<Sources> | null = null;

	// Option lists are fetched once per page load, on first Edit click.
	function loadSources(): Promise<Sources> {
		if (sourcesPromise) return sourcesPromise;
		sourcesPromise = (async () => {
			const [drivers, partners] = await Promise.all([
				fetchApprovedDrivers().catch(() => []),
				supabase.from('partners').select('id, display_name, hotel_name, agency_name, type').in('type', ['hotel', 'agency']).eq('status', 'approved').order('display_name', { ascending: true })
					.then(({ data }) => data ?? []),
			]);
			return {
				drivers:  [{ value: '', label: 'Unassigned' }, ...drivers.map((d) => ({ value: d.id, label: d.fullName }))],
				partners: [{ value: '', label: '— none —' }, ...partners.map((p: any) => ({ value: String(p.id), label: `${p.display_name || p.hotel_name || p.agency_name || p.id} (${p.type})` }))],
			};
		})();
		return sourcesPromise;
	}

	const INPUT_CLS = 'w-full px-3 py-2.5 border border-neutral-200 rounded-xl text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-[#0C6B95]/20 focus:border-[#0C6B95] bg-neutral-50';

	function inputHtml(def: FieldDef, row: Row, sources: Sources): string {
		const raw = row[def.key];
		const val = raw == null ? '' : String(raw);
		const name = `name="${esc(def.key)}"`;
		switch (def.type) {
			case 'textarea':
				return `<textarea ${name} rows="3" class="${INPUT_CLS}">${esc(val)}</textarea>`;
			case 'checkbox':
				return `<label class="inline-flex items-center gap-2 py-2.5 text-sm text-neutral-800">
					<input type="checkbox" ${name} ${raw ? 'checked' : ''} class="w-4 h-4 rounded border-neutral-300 accent-[#0C6B95]" /> Yes
				</label>`;
			case 'select': {
				const options = (def.source ? sources[def.source] : def.options) ?? [];
				// Keep the stored value selectable even when it is not in the list (a driver who
				// was since deactivated, a legacy status). Never fall back to a free-text input —
				// that would let an id be typed by hand.
				const known = options.some((o) => o.value === val);
				const currentLabel = def.key === 'driver_uid' ? (row.driver || val) : val;
				const extra = !known && val ? `<option value="${esc(val)}" selected>${esc(currentLabel)} (current)</option>` : '';
				const blank = def.nullable && !options.some((o) => o.value === '') ? `<option value="">—</option>` : '';
				return `<select ${name} class="${INPUT_CLS}">${blank}${extra}${options.map((o) =>
					`<option value="${esc(o.value)}" ${o.value === val ? 'selected' : ''}>${esc(o.label)}</option>`).join('')}</select>`;
			}
			case 'date':
				return `<input type="date" ${name} value="${esc(val)}" class="${INPUT_CLS}" />`;
			case 'time':
				return `<input type="time" ${name} value="${esc(val.slice(0, 5))}" class="${INPUT_CLS}" />`;
			case 'int':
				return `<input type="number" step="1" ${name} value="${esc(val)}" class="${INPUT_CLS}" />`;
			case 'money':
				return `<input type="number" step="0.01" ${name} value="${esc(val)}" class="${INPUT_CLS}" />`;
			case 'number':
				return `<input type="number" step="any" ${name} value="${esc(val)}" class="${INPUT_CLS}" />`;
			default:
				// Address fields get Google Places autocomplete once the form is in the DOM.
				return `<input type="text" ${name} value="${esc(val)}" ${def.places ? 'data-places="1" autocomplete="off"' : ''} class="${INPUT_CLS}" />`;
		}
	}

	function renderEditForm(row: Row, defs: FieldDef[], sources: Sources): string {
		const cells = defs.map((def) => {
			if (def.readonly) return field(def.label, row[def.key]);
			return `<div class="${def.full ? 'col-span-2' : ''} flex flex-col gap-1">
				<label class="text-[11px] uppercase tracking-wider text-neutral-500">${esc(def.label)}</label>
				${inputHtml(def, row, sources)}
			</div>`;
		});
		return `<form id="res-edit-form" class="grid grid-cols-2 gap-4" novalidate>${cells.join('')}</form>`;
	}

	/* ── Google Places on the address fields ── */
	// The dropdown (.pac-container) is appended to <body> and positioned against the
	// document, so inside a scrolling modal it drifts away from its input. We pin the
	// containers we created to the focused input's viewport box instead, and drop them
	// when the form goes away — leaving other pages' autocompletes untouched.
	let ownPacContainers: HTMLElement[] = [];

	function pacSnapshot(): Set<Element> {
		return new Set(document.querySelectorAll('.pac-container'));
	}

	function collectNewPacContainers(before: Set<Element>) {
		for (const el of document.querySelectorAll<HTMLElement>('.pac-container')) {
			if (!before.has(el) && !ownPacContainers.includes(el)) ownPacContainers.push(el);
		}
	}

	function repositionPac() {
		if (!ownPacContainers.length) return;
		const input = document.activeElement as HTMLElement | null;
		if (!input || !(input instanceof HTMLInputElement) || input.dataset.places !== '1') return;
		const r = input.getBoundingClientRect();
		for (const c of ownPacContainers) {
			c.style.position = 'fixed';
			c.style.left = `${r.left}px`;
			c.style.top = `${r.bottom}px`;
			c.style.width = `${r.width}px`;
		}
	}

	function teardownPlaces() {
		for (const c of ownPacContainers) c.remove();
		ownPacContainers = [];
	}

	async function wirePlaces() {
		const inputs = Array.from(body.querySelectorAll<HTMLInputElement>('input[data-places="1"]'));
		if (!inputs.length) return;
		const before = pacSnapshot();
		await Promise.all(inputs.map((el) => attachPlacesAutocomplete(el).catch(() => null)));
		collectNewPacContainers(before);
		repositionPac();
	}

	/* ══════════════════ Wiring ══════════════════ */

	const modal  = document.getElementById('res-detail-modal')!;
	const body   = document.getElementById('res-detail-body')!;
	const title  = document.getElementById('res-detail-title')!;
	const refEl  = document.getElementById('res-detail-ref')!;
	const status = document.getElementById('res-detail-status')!;
	const editBtn   = document.getElementById('res-detail-edit') as HTMLButtonElement;
	const deleteBtn = document.getElementById('res-detail-delete') as HTMLButtonElement;
	const cancelBtn = document.getElementById('res-detail-cancel') as HTMLButtonElement;
	const saveBtn   = document.getElementById('res-detail-save') as HTMLButtonElement;

	const KIND_TABLE: Record<Kind, string> = {
		transfer: 'transfers', tour: 'tours', experience: 'experiences', request: 'requests',
	};

	let currentRow: Row | null = null;
	let currentKind: Kind | null = null;
	let currentDefs: FieldDef[] = [];
	let currentSources: Sources | null = null;
	let mode: 'view' | 'edit' = 'view';

	function setStatus(msg: string, tone: 'info' | 'success' | 'error') {
		status.textContent = msg;
		status.className = `mr-auto text-xs ${tone === 'error' ? 'text-red-600' : tone === 'success' ? 'text-emerald-600' : 'text-[#0C6B95]'}`;
		status.classList.remove('hidden');
	}
	function clearStatus() { status.classList.add('hidden'); status.textContent = ''; }

	// Toggle both, because neither alone is enough: the Edit/Delete buttons carry
	// `inline-flex`, which wins over Tailwind's `hidden` in the cascade, while
	// Cancel/Save start with `hidden` in their markup.
	function show(el: HTMLElement, visible: boolean) {
		el.classList.toggle('hidden', !visible);
		el.style.display = visible ? '' : 'none';
	}

	function setMode(m: 'view' | 'edit') {
		mode = m;
		const editing = m === 'edit';
		show(editBtn, !editing);
		// Requests have their own delete flow on the Requests page — never show Delete for them.
		show(deleteBtn, !editing && currentKind !== 'request');
		show(cancelBtn, editing);
		show(saveBtn, editing);
	}

	function renderView() {
		if (!currentRow || !currentKind) return;
		teardownPlaces();
		body.innerHTML = currentKind === 'transfer'
			? renderTransfer(currentRow)
			: currentKind === 'request'
			? renderRequest(currentRow)
			: renderTourOrExperience(currentRow, currentKind);
	}

	async function enterEdit() {
		if (!currentRow || !currentKind) return;
		editBtn.disabled = true;
		setStatus('Loading…', 'info');
		try {
			currentSources = await loadSources();
		} finally {
			editBtn.disabled = false;
		}
		if (!currentRow || mode === 'edit') return; // modal closed meanwhile
		currentDefs = fieldsFor(currentKind);
		body.innerHTML = renderEditForm(currentRow, currentDefs, currentSources);
		clearStatus();
		setMode('edit');
		(body.querySelector('input, select, textarea') as HTMLElement | null)?.focus();
		wirePlaces();
	}

	function cancelEdit() {
		clearStatus();
		setMode('view');
		renderView();
	}

	function close() {
		teardownPlaces();
		modal.classList.add('hidden');
		currentRow = null;
		currentKind = null;
		clearStatus();
	}

	document.getElementById('res-detail-overlay')?.addEventListener('click', () => (mode === 'edit' ? cancelEdit() : close()));
	document.getElementById('res-detail-close')?.addEventListener('click', () => (mode === 'edit' ? cancelEdit() : close()));
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape' || modal.classList.contains('hidden')) return;
		if (mode === 'edit') cancelEdit(); else close();
	});
	document.getElementById('res-detail-card')?.addEventListener('scroll', repositionPac, { passive: true });
	body.addEventListener('focusin', (e) => {
		if ((e.target as HTMLElement)?.dataset?.places === '1') repositionPac();
	});
	editBtn.addEventListener('click', enterEdit);
	cancelBtn.addEventListener('click', cancelEdit);

	/* ── Save (admin) ── */
	saveBtn.addEventListener('click', async () => {
		if (!currentRow || !currentKind || !currentSources) return;
		const form = body.querySelector<HTMLFormElement>('#res-edit-form');
		if (!form) return;

		const values: Record<string, string | boolean> = {};
		for (const def of currentDefs) {
			if (def.readonly) continue;
			const el = form.elements.namedItem(def.key) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
			if (!el) continue;
			values[def.key] = (el as HTMLInputElement).type === 'checkbox' ? (el as HTMLInputElement).checked : el.value;
		}

		let payload: Record<string, unknown>;
		try {
			payload = buildUpdatePayload(currentRow, currentDefs, values);
		} catch (err: any) {
			setStatus(err?.message ?? 'Invalid value', 'error');
			return;
		}

		// Driver changes go through the shared assignment builder so the audit columns
		// and the forward-only ride_status rule stay consistent with the list pages.
		if ('driver_uid' in payload) {
			const newUid = String(payload.driver_uid ?? '');
			const opt = currentSources.drivers.find((d) => d.value === newUid);
			const { data: { session } } = await supabase.auth.getSession();
			const explicitStatus = payload.ride_status;
			Object.assign(payload, buildAssignmentUpdate({
				newDriverUid: newUid,
				newDriverName: opt?.label ?? '',
				currentRideStatus: String(currentRow.ride_status ?? 'new'),
				adminUserId: session?.user?.id ?? '',
			}));
			if (explicitStatus !== undefined) payload.ride_status = explicitStatus;
		}

		// Transfer vehicle select carries the slug; keep the denormalised name in sync,
		// same convention as the admin "Add booking" form (name + lowercased slug).
		if (currentKind === 'transfer' && 'vehicle_slug' in payload) {
			const opt = VEHICLE_OPTIONS.find((v) => v.value === payload.vehicle_slug);
			payload.vehicle_name = payload.vehicle_slug ? (opt?.label ?? String(payload.vehicle_slug)) : '';
		}

		if (!Object.keys(payload).length) { setStatus('No changes.', 'info'); return; }

		if (typeof payload.date === 'string' && payload.date && isPastBookingDate(payload.date)
			&& !confirm('The new date is in the past. Save anyway?')) return;

		saveBtn.disabled = true;
		setStatus('Saving…', 'info');
		// `.select()` so we can tell a real write from an RLS no-op: an update that matches
		// no rows returns 204 with no error, which would otherwise read as success.
		const { data, error } = await supabase.from(KIND_TABLE[currentKind])
			.update(payload).eq('id', currentRow.id).select('id');
		saveBtn.disabled = false;
		if (error) {
			console.error('Booking update failed:', error);
			setStatus(`[${error.code ?? 'err'}] ${error.message}`, 'error');
			return;
		}
		if (!data || data.length === 0) {
			setStatus('Nothing was saved — the booking no longer exists, or your admin session expired. Reload and try again.', 'error');
			return;
		}

		Object.assign(currentRow, payload);
		const detail = { kind: currentKind, id: currentRow.id, action: 'update' };
		setMode('view');
		renderView();
		setStatus('Saved.', 'success');
		window.dispatchEvent(new CustomEvent('opaway:reservation-changed', { detail }));
	});

	/* ── Delete (admin) ── */
	deleteBtn.addEventListener('click', async () => {
		if (!currentRow || !currentKind) return;
		const table = KIND_TABLE[currentKind];
		if (!table) return;
		if (!confirm('Permanently delete this booking? This cannot be undone.')) return;
		deleteBtn.disabled = true;
		const { error } = await supabase.from(table).delete().eq('id', currentRow.id);
		deleteBtn.disabled = false;
		if (error) {
			console.error('Booking delete failed:', error);
			alert(`Delete failed: [${error.code ?? 'unknown'}] ${error.message}`);
			return;
		}
		const detail = { kind: currentKind, id: currentRow.id, action: 'delete' };
		close();
		window.dispatchEvent(new CustomEvent('opaway:reservation-changed', { detail }));
	});

	(window as any).OpawayReservationDetail = {
		open(row: Row, kind: Kind) {
			currentRow = row;
			currentKind = kind;
			const labels: Record<Kind, string> = { transfer: 'Transfer booking', tour: 'Tour booking', experience: 'Experience booking', request: 'Request' };
			title.textContent = labels[kind] ?? 'Booking';
			refEl.textContent = row?.id ? `Ref ${String(row.id).slice(0, 8).toUpperCase()}` : '';
			clearStatus();
			setMode('view');
			renderView();
			modal.classList.remove('hidden');
		},
		close,
	};
</script>
